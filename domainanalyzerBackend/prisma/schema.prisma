// =============================================================================
// AI Visibility — Clean Schema (Foundational Rewrite)
// -----------------------------------------------------------------------------
// One wizard, five phases (crawl → profile → competitors → topics → select → run).
// Domain identity is split from profile, inferred attributes, and wizard state.
// All "phrase / intent / unified / enhanced / semantic / niche" legacy tables
// have been removed. The blog/campaign/wordpress/gsc/audit pipelines are
// preserved untouched (only deprecated columns dropped).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

model User {
  id                           Int       @id @default(autoincrement())
  email                        String    @unique
  // Nullable for Google-only accounts that never set a local password.
  password                     String?
  name                         String?
  // Google "sub" / stable user id from OIDC. Set when the user signs in via
  // Google OAuth; matches happen by googleId first, then fall back to email.
  googleId                     String?   @unique
  emailVerified                Boolean   @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
  // Forgot-password flow: SHA-256 hash of the raw token sent in the email
  // (so a DB leak alone cannot mint reset tokens). Cleared on use.
  passwordResetTokenHash       String?
  passwordResetTokenExpiry     DateTime?
  // Brute-force defenses for /api/auth/login.
  loginFailureCount            Int       @default(0)
  lockedUntil                  DateTime?
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  // Bumped on password change / reset / "log out everywhere" to invalidate
  // every outstanding access token without a Redis blacklist. The JWT
  // middleware compares this against the value baked into the token.
  tokenVersion                 Int       @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Anon-funnel anti-abuse signals captured at signup. Surveyed by the
  // background fingerprint-reuse flagger; not used in real-time auth.
  signupIp          String?
  signupFingerprint String?
  // Soft per-user wizard run cap. Default 1 = the "one free audit" promise.
  // Paid plans raise this. The runner reads this at quota-check time.
  wizardRunsAllowed Int       @default(1)
  lastWizardRunAt   DateTime?
  // Set by the background reuse flagger when a User shares fingerprint/ip
  // with multiple other recent signups. Suspicious users are throttled, not
  // banned — see WizardSession quota checks.
  suspicious        Boolean   @default(false)

  domains              Domain[]
  googleSearchConsole  GoogleSearchConsoleConnection?
  wordpressIntegration WordpressIntegration?
  publishLogs          WordpressPublishLog[]
  generationJobs       GenerationJob[]
  refreshTokens        RefreshToken[]
  // Wizard sessions where this user signed up from an anonymous funnel.
  wizardSessionsLinked WizardSession[]                @relation("WizardSessionLinkedUser")
  // Wizard sessions where this user IS the anonymous shadow identity.
  // Shadow users have email = anon-{sessionId}@system.local and an
  // unusable password hash. They never log in via the normal auth path.
  wizardSessionsAnon   WizardSession[]                @relation("WizardSessionAnonUser")
  folders              Folder[]
  files                File[]
  chatThreads          ChatThread[]
}

// ── Conversational agent (chat) ──────────────────────────────────────────────
// One thread per conversation; messages persist the AI SDK UIMessage `parts`
// array verbatim (text + tool-invocation parts) so a reloaded thread renders
// its inline generative UI exactly as before.
model ChatThread {
  id        Int           @id @default(autoincrement())
  userId    Int
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        Int        @id @default(autoincrement())
  threadId  Int
  // 'user' | 'assistant' | 'system'
  role      String
  // AI SDK UIMessage.parts (text + tool parts), stored verbatim.
  parts     Json
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Opaque, rotating refresh tokens.
//
// Stored as SHA-256(token) so a DB leak alone cannot mint sessions. Every
// successful refresh issues a new token (rotation) and revokes the
// previous one (same familyId, parentId = previous.id). Presenting an
// already-revoked token in the same family is treated as theft: the
// entire family is revoked, forcing the legitimate user to re-login.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  familyId  String
  parentId  Int?
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  reusedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// -----------------------------------------------------------------------------
// Domain — identity only. Profile / inferred / wizard state live in side tables.
// -----------------------------------------------------------------------------

model Domain {
  id                Int      @id @default(autoincrement())
  userId            Int
  url               String // canonical https://host
  host              String // normalized: lowercased, no www, no path
  isCompanyDomain   Boolean  @default(false)
  // GSC analytics property id, kept here because GSC integration writes to it.
  googleAnalyticsId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  profile     DomainProfile?
  inferred    DomainInferred?
  wizardState WizardState?
  crawls      CrawlSnapshot[]
  competitors Competitor[]
  keywords    Keyword[]
  prompts     Prompt[]
  runs        AiRun[]
  campaigns   Campaign[]
  auditResult AuditResult?

  @@unique([userId, host])
  @@index([userId])
  @@index([userId, isCompanyDomain])
}

// User-supplied profile from Step 1 of the wizard.
model DomainProfile {
  domainId       Int      @id
  country        String?
  state          String?
  industry       String?
  targetLocation String?
  // { keywords: string[], prompts: string[] } — survives regenerations.
  customSeeds    Json?
  updatedAt      DateTime @updatedAt
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

// LLM/heuristic-inferred attributes synthesized from CrawlSnapshot.
// Absorbs what the old SemanticAnalysis.contentSummary stored.
model DomainInferred {
  domainId       Int      @id
  companyName    String?
  companySize    String? // solo | smb | mid | enterprise
  brandVoice     Json?
  targetAudience Json?
  productsJson   Json?
  schemaOrgJson  Json?
  // float[] embedding stored as Json — used for competitor + prompt similarity.
  embedding      Json?
  // sha256 of the crawl text the embedding was computed from. When a fresh
  // crawl produces identical content, we skip the embedText call and reuse
  // the stored embedding (saves ~$0.0001 + 1–2 s per wizard re-run).
  crawlHash      String?
  // Free-form text summary for downstream content generation.
  summary        String?
  inferredAt     DateTime @default(now())
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

// Per-domain wizard progress. Replaces AnalysisPhase + Domain.currentStep + selectionDraft.
model WizardState {
  domainId       Int      @id
  // { crawl: 'completed', profile: 'completed', competitors: 'running', ... }
  phases         Json     @default("{}")
  // { keywordIds: number[], promptIds: number[] } — debounced auto-save.
  selectionDraft Json?
  updatedAt      DateTime @updatedAt
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

// One row per crawl. Versioned — old crawls are retained, never overwritten.
model CrawlSnapshot {
  id           Int      @id @default(autoincrement())
  domainId     Int
  pagesScanned Int
  // [{ url, title, description, ogTags, schemaJson, content }]
  pages        Json
  rawText      String // concatenated content blob for downstream LLM
  contextJson  Json? // synthesized structure
  quality      Json? // % metrics
  policy       Json? // robots + sitemap discovery
  tokenUsage   Int      @default(0)
  createdAt    DateTime @default(now())
  domain       Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
}

// Single competitor table. Replaces CompetitorAnalysis + SuggestedCompetitor + CompetitorTracking.
// Each row is one verified-or-pending competitor company.
model Competitor {
  id              Int      @id @default(autoincrement())
  domainId        Int
  competitorHost  String // normalized host
  // 'serp' | 'overlap' | 'mention' | 'enrichment' | 'llm-rank'
  source          String
  // Raw payload from each discovery source (merged on conflict).
  rawSignals      Json
  verified        Boolean  @default(false)
  industry        String?
  location        String?
  companySize     String?
  similarityScore Float? // 0..1, deterministic
  threatLevel     String? // High | Medium | Low (LLM-labelled)
  rank            Int? // final rank within domain
  reasoning       String? // one-line LLM justification
  isSelected      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, competitorHost])
  @@index([domainId, isSelected])
  @@index([domainId, rank])
}

// Keywords. Cleaned from Keyword + KeywordAnalysis + GeneratedIntentPhrase.keywordId.
model Keyword {
  id         Int      @id @default(autoincrement())
  domainId   Int
  term       String
  intent     String // Informational | Commercial | Transactional | Navigational
  source     String // 'ai' | 'custom'
  volume     Int?
  difficulty String? // Low | Medium | High
  cpc        Float?
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  prompts    Prompt[]

  @@unique([domainId, term])
  @@index([domainId, isSelected])
  // Soft-reset deletes AI-generated keywords via (domainId, source='ai').
  // Without this index, the planner did a sequential scan on source after
  // narrowing by domainId.
  @@index([domainId, source])
}

// Prompts. Each prompt is a discrete query we send to the LLM roster.
// Metadata fields drive category-weighted scoring on the dashboard — without
// them the audit can't separate "unbranded category recommendation" signal
// from "branded sanity-check" noise.
model Prompt {
  id                  Int             @id @default(autoincrement())
  domainId            Int
  keywordId           Int?
  text                String
  intent              String? // Informational | Commercial | Transactional | Navigational
  source              String // 'ai' | 'custom'
  isSelected          Boolean         @default(false)
  /// True if the user marked this prompt for recurring tracked re-testing.
  isTracked           Boolean         @default(false)
  /// Timestamp of the most recent tracked run that included this prompt.
  lastTrackedRunAt    DateTime?
  // ── Audit-research metadata (Soar / Profound / Ahrefs taxonomy) ────────
  /// One of: unbranded_recommendation | top_n_listicle | alternatives_to_competitor
  ///        | problem_statement | brand_vs_competitor | branded_trust
  category            String?
  /// Funnel position: awareness | consideration | decision
  intentStage         String?
  /// Persona that would naturally ask this prompt (e.g. "Series B SaaS founder").
  persona             String?
  /// Job-to-be-done / use case (e.g. "tracking team OKRs").
  useCase             String?
  /// Constraint qualifier (budget, scale, integration, vertical).
  constraint          String?
  /// True if the prompt explicitly names the user's brand.
  isBranded           Boolean         @default(false)
  /// Competitor host explicitly named in the prompt (alternatives / vs queries).
  competitorMentioned String?
  createdAt           DateTime        @default(now())
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  keyword             Keyword?        @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  results             AiQueryResult[]

  @@index([domainId, isSelected])
  // Daily sweeper enumerates tracked prompts per domain.
  @@index([domainId, isTracked])
  @@index([domainId, category])
  @@index([keywordId])
  // Soft-reset deletes AI-generated prompts via (domainId, source='ai').
  @@index([domainId, source])
}

// One run = one execution of the user's selected prompts × selected models.
// Replaces AnalysisReport + DashboardAnalysis + ModelPerformance + PerformanceInsight.
model AiRun {
  id        Int             @id @default(autoincrement())
  domainId  Int
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  status    String          @default("running") // running | completed | failed
  // How this run was triggered: 'audit' (manual wizard run) | 'weekly' (tracked
  // prompt re-test family). Audit dashboards filter on kind='audit' so tracked
  // runs never pollute the existing trend/runs charts.
  kind      String          @default("audit")
  // Aggregate scores: { presenceRate, avgRelevance, avgSentiment, avgOverall, perModel }
  summary   Json?
  domain    Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  results   AiQueryResult[]

  @@index([domainId, startedAt])
  // The hot query is "latest completed run for domain": where { domainId,
  // status: 'completed' } orderBy startedAt desc. Without this compound index
  // the planner narrows by domainId then sequentially scans on status.
  @@index([domainId, status, startedAt])
  // "latest completed tracked run for domain" — used by the tracked-prompts
  // endpoint and the in-flight dedupe check.
  @@index([domainId, kind, status, startedAt])
}

model AiQueryResult {
  id                 Int      @id @default(autoincrement())
  runId              Int
  promptId           Int
  model              String // e.g. 'gpt-4o-mini', 'claude-3-5-haiku', 'gemini-1.5-flash'
  status             String   @default("success") // success | failed
  errorMessage       String?
  response           String
  presence           Int      @default(0) // 0 | 1
  relevance          Int      @default(0) // 0..10 (always measurable — answer quality)
  sentiment          Int? // -10..10. NULL when presence=0 (no brand to measure sentiment toward)
  accuracy           Int? // 0..10. NULL when presence=0 (no claims to verify)
  rankPosition       Int? // 1-based position when brand appears in a numbered list; NULL otherwise
  overall            Float    @default(0) // 0..10. Always 0 when presence=0
  scorerSummary      String? // one-line LLM summary of the brand mention (or absence)
  factualClaims      Json? // [{ claim, verdict: true|false|uncertain }] — claims about the brand the LLM made
  competitorHosts    Json? // string[] — competitor hosts mentioned (legacy / fast lookup)
  // [{ url, title, host }] — every link or bare URL the model cited
  citations          Json?
  // [{ host, count, sentiment }] — per-competitor mention breakdown with sentiment
  competitorMentions Json?
  latencyMs          Int?
  costUsd            Float?
  createdAt          DateTime @default(now())
  run                AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  prompt             Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, status])
  @@index([promptId])
}

// -----------------------------------------------------------------------------
// Blog / Campaign / Wordpress / GSC / Audit — preserved
// (deprecated columns and frozen archive tables removed)
// -----------------------------------------------------------------------------

model Campaign {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  domainId    Int
  domain      Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  topics      CampaignTopic[]

  @@index([domainId])
}

enum CampaignNodeSource {
  MANUAL
  AI
}

model CampaignTopic {
  id             Int                  @id @default(autoincrement())
  campaignId     Int
  campaign       Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  summary        String?
  aiSummary      String?
  latestDraftId  Int?
  latestDraft    WordpressPublishLog? @relation("TopicLatestDraft", fields: [latestDraftId], references: [id])
  status         String               @default("active")
  source         CampaignNodeSource   @default(MANUAL)
  order          Int                  @default(0)
  aiMetadata     Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  keywords       CampaignKeyword[]
  generationJobs GenerationJob[]

  @@index([campaignId])
  @@index([latestDraftId])
}

model CampaignKeyword {
  id         Int                @id @default(autoincrement())
  topicId    Int
  topic      CampaignTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  term       String
  volume     Int?
  difficulty String?
  intent     String?
  status     String             @default("active")
  source     CampaignNodeSource @default(MANUAL)
  aiMetadata Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([term, topicId])
  @@index([topicId])
}

model WordpressIntegration {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @unique
  siteUrl         String
  username        String
  password        String
  lastPublishedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishLogs     WordpressPublishLog[]
}

model WordpressPublishLog {
  id                       Int                   @id @default(autoincrement())
  userId                   Int
  wordpressUrl             String
  wordpressPostId          Int?
  primaryKeyword           String?
  normalizedPrimaryKeyword String?
  generationJobId          String?
  generationTopicId        Int?
  title                    String?
  slug                     String?
  status                   String?
  response                 Json?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  integrationId            Int?
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration              WordpressIntegration? @relation(fields: [integrationId], references: [id])
  campaignTopics           CampaignTopic[]       @relation("TopicLatestDraft")

  @@index([userId])
  @@index([generationJobId])
  @@index([generationJobId, normalizedPrimaryKeyword])
  @@index([generationTopicId])
}

model GenerationJob {
  id        Int           @id @default(autoincrement())
  jobId     String        @unique
  topicId   Int
  userId    Int
  status    String        @default("pending") // pending | generating | completed | failed
  progress  Int           @default(0) // 0..100
  phase     String?
  error     String?
  draftId   Int?
  startedAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  topic     CampaignTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
  @@index([userId, status])
}

model GoogleSearchConsoleConnection {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail      String?
  googleUserId     String?
  accessToken      String
  refreshToken     String // encrypted
  tokenExpiry      DateTime
  selectedProperty String?
  isConnected      Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model AuditResult {
  id            Int          @id @default(autoincrement())
  domainId      Int          @unique
  performance   Float
  seo           Float
  accessibility Float
  bestPractices Float
  pwa           Float
  audits        Json
  screenshotUrl String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  domain        Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  n8nRequests   N8nRequest[]

  @@index([domainId])
}

model N8nRequest {
  id             Int         @id @default(autoincrement())
  requestId      String      @unique @default(uuid())
  auditResultId  Int
  auditResult    AuditResult @relation(fields: [auditResultId], references: [id], onDelete: Cascade)
  status         String      @default("pending") // pending | processing | completed | failed
  requestPayload Json
  responseData   Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([auditResultId])
  @@index([requestId])
}

// -----------------------------------------------------------------------------
// Anon wizard sessions — backbone for the pre-signup AI Visibility audit.
// -----------------------------------------------------------------------------
//
// A WizardSession represents a single anonymous browser doing a wizard run.
// The wizard work is stored as JSON snapshots on the row itself rather than
// rooted in `Domain`, so existing Domain-bound code (41 query sites) stays
// untouched. On signup the linkage handler materializes the snapshot into
// real Domain / CrawlSnapshot / Competitor / Prompt rows owned by the new
// User. After expiry the row is garbage-collected.
//
// `cookieTokenHash` is sha256(cookieToken). The plaintext token lives only
// in the user's signed HTTP-only cookie. ip + fingerprintHash + userAgent
// are captured for per-identity rate limiting and the post-signup reuse
// flagger.
// -----------------------------------------------------------------------------

model WizardSession {
  id              Int       @id @default(autoincrement())
  cookieTokenHash String    @unique
  ip              String?
  fingerprintHash String?
  userAgent       String?
  // Domain identity entered at Step 1. Optional snapshot — useful for
  // diagnostics and for the orphan-cleanup sweeper even when a Domain
  // row hasn't been created yet.
  domainUrl       String?
  domainHost      String?
  // Step snapshots. Each holds the public-facing payload for that step.
  // Now mostly redundant with the real Domain rows that get created for
  // anon sessions, but kept for backward compatibility and diagnostics.
  profileData     Json?
  crawlData       Json?
  competitorsData Json?
  topicsData      Json?
  // Step pointer used by resume + signup-wall logic.
  step            String    @default("idle") // idle | profile | crawl | competitors | topics | walled | complete
  // Shadow User row created at session-issue time. The anon wizard runs
  // creates Domain / CrawlSnapshot / Competitor / Prompt rows owned by
  // this user. On signup the linkage handler reassigns Domain.userId
  // from anonUserId → linkedUserId, then optionally deletes the shadow
  // user. Nullable for backward compatibility with sessions issued
  // before this migration.
  anonUserId      Int?
  // Set once the user signs up. linkedDomainId points at the (just-
  // transferred) Domain so the post-signup redirect knows where to go.
  linkedUserId    Int?
  linkedDomainId  Int?
  linkedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime

  linkedUser User? @relation("WizardSessionLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  anonUser   User? @relation("WizardSessionAnonUser", fields: [anonUserId], references: [id], onDelete: SetNull)

  @@index([linkedUserId])
  @@index([anonUserId])
  @@index([fingerprintHash])
  @@index([ip])
  @@index([expiresAt])
  @@index([domainHost])
}

// -----------------------------------------------------------------------------
// Per-domain wizard result cache. Keyed on (normalizedHost, step, cacheKey)
// so identical work is shared across users and across re-runs. Cache hits
// avoid every external LLM/SerpAPI call.
// -----------------------------------------------------------------------------

model WizardRunCache {
  id             Int      @id @default(autoincrement())
  // Normalized host (lowercased, no www, no path). Same normalization as
  // Domain.host so a cache populated by user A is reusable by user B.
  normalizedHost String
  // Step bucket: "crawl" | "competitors" | "topics" | "ai-run".
  step           String
  // Extra key for parameterized steps: prompt set hash, model set hash,
  // etc. "default" if no parameterization.
  cacheKey       String   @default("default")
  payload        Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([normalizedHost, step, cacheKey])
  @@index([expiresAt])
  @@index([normalizedHost])
}

// -----------------------------------------------------------------------------
// Per-call cost log. Every paid external service (OpenRouter LLM, SerpAPI,
// PageSpeed, n8n) records an estimated USD cost here. The daily circuit
// breaker sums this table for the current day and blocks new anon runs
// when the threshold is hit.
// -----------------------------------------------------------------------------

model ApiSpendLog {
  id              Int      @id @default(autoincrement())
  service         String // "openrouter" | "serpapi" | "pagespeed" | "n8n"
  userId          Int? // null for anonymous spend
  sessionId       Int? // WizardSession.id for anon spend
  domainHost      String?
  costEstimateUsd Float
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([service, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  parentId  Int?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")
  files     File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentId])
}

model File {
   id           Int      @id @default(autoincrement())
   name         String
   url          String   // Cloudinary hosted URL
   cloudinaryId String   // Public ID for Cloudinary management
   size         Int      // Bytes
   format       String   // e.g., "pdf", "png", "jpg"
   userId       Int
   folderId     Int?     // If null, file is in the root "Home"
   user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
   folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
   createdAt    DateTime @default(now())
   @@index([userId])
   @@index([folderId])
}
