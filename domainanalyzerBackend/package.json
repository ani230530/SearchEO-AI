{
  "name": "ai-visibility-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "sync:prompt-catalog": "node scripts/sync-prompt-catalog-from-sheet.cjs",
    "backup:blogs": "ts-node-dev --transpile-only scripts/backup-blogs.ts",
    "restore:blogs": "ts-node-dev --transpile-only scripts/restore-blogs.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@prisma/client": "6.10.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "ai": "^6.0.196",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.66.5",
    "cheerio": "^1.1.0",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "google-ads-api": "^11.0.0",
    "googleapis": "^166.0.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.12",
    "openai": "^5.5.1",
    "puppeteer": "^24.34.0",
    "resend": "^6.12.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "6.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
