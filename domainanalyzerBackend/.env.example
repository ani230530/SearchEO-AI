# =============================================================================
# Backend env. Copy to .env and fill in the values. Anything required at boot
# is enforced by src/config/authEnv.ts — the server refuses to start with
# missing/default auth secrets.
# =============================================================================

# Database — Postgres connection string (Neon, Supabase, local docker).
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# Auth secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 chars. MUST differ from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional auth tuneables (defaults shown).
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_MINUTES=1440

# URLs.
FRONTEND_URL=http://localhost:8080
# Comma-separated extra browser origins allowed to call this API.
# Usually set this to the same value as FRONTEND_URL; add preview URLs only when needed.
CORS_ORIGINS=http://localhost:8080,https://searcheo.ai,https://www.searcheo.ai

# Blog CMS admin bootstrap.
# If these are set, the backend seeds/promotes the admin account on startup.
# You can also run `npm run db:seed` manually.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change-me-now
# Optional display name for the seeded admin account.
SEED_ADMIN_NAME=Admin

# Defaults to http://localhost:${PORT}. Set in production / behind a proxy so
# verification emails, Google OAuth callbacks, and n8n blog callbacks use the
# externally-reachable URL.
# BACKEND_PUBLIC_URL=https://your-tunnel.ngrok.app
PORT=3002
NODE_ENV=development

# Google OAuth (same client is used for login and Google Search Console).
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# In production set BACKEND_PUBLIC_URL=https://your-backend.example.com, or set
# the two redirect URI vars explicitly. Authorized redirect URIs must include BOTH:
#   - http://localhost:3002/api/auth/google/callback        (GSC connector)
#   - http://localhost:3002/api/auth/google/auth-callback   (login/signup)
# Production example:
#   - https://your-backend.example.com/api/auth/google/callback
#   - https://your-backend.example.com/api/auth/google/auth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3002/api/auth/google/auth-callback

# GSC OAuth token encryption key (32+ chars). Used to encrypt refresh tokens
# stored in GoogleSearchConsoleConnection.refreshToken.
GOOGLE_ENCRYPTION_KEY=

# Email — transactional sends via Resend (https://resend.com). Use Resend
# rather than SMTP/Gmail because outbound SMTP is blocked or unreliable on
# Render, Vercel, Fly, etc. Required: an API key + a verified sender.
#
# For dev with no verified domain yet, set EMAIL_FROM=onboarding@resend.dev
# — Resend will deliver only to the email address on your Resend account.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional integrations (omit if you're not using them).
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# REDIS_URL=redis://localhost:6379
# SERP_API_KEY=
# SERPER_API_KEY=
# CALLBACK_BASE_URL=https://your-backend.example.com
# N8N_BLOG_CALLBACK_SECRET=some-shared-secret
# N8N_BLOG_GENERATION_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/some-uuid
# N8N_BLOG_GENERATION_USERNAME=admin
# N8N_BLOG_GENERATION_PASSWORD=112233

# Domain-analysis prompt research via n8n. Optional: when omitted, the backend
# falls back to the built-in Serper/LLM prompt generator.
# N8N_PROMPT_RESEARCH_WEBHOOK_URL=https://n8n.example.com/webhook/...
# N8N_PROMPT_RESEARCH_API_KEY=
# N8N_PROMPT_RESEARCH_API_KEY_HEADER=x-api-key
# N8N_PROMPT_RESEARCH_TIMEOUT_MS=45000

# Prompt catalog Google Sheet sync. Default: poll every 60 seconds, import
# sheet rows, then add newly added catalog prompts to matching domains.
# PROMPT_CATALOG_SHEET_ID=1n-WdvJDtwBy10SAaIkmBCkyQd5Nkp8q2NZ-yvxbOA2c
# PROMPT_CATALOG_SYNC_INTERVAL_MS=60000
# DISABLE_PROMPT_CATALOG_SHEET_SYNC=true

# Local/dev only: keep the API running without processing scheduled tracked
# prompt sweeps from Redis.
# DISABLE_TRACKED_PROMPT_SCHEDULER=true
